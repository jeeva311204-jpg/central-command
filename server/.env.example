# ChangeFlow Enterprise Environment Variables Configuration

# Server & Network
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=changeflow-enterprise-super-secure-jwt-secret-key-2026

# MongoDB Connection String (Atlas Replica Set or Local Replica Set for multi-document transactions)
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/changeflow?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017/changeflow?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/changeflow

# Background Automation & SLA Escalations Schedule
SLA_CRON_SCHEDULE="0 * * * *"

# Outbound Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="ChangeFlow Enterprise <alerts@yourcompany.com>"
