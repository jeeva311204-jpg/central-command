generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Employee, HOD, Engineer, Maintenance, Finance, Procurement, Quality, Management, Admin
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique // PROD, MAINT, QA, ENG, LOG
  hodId     String?
  users     User[]
  budgets   Budget[]
  proposals Proposal[]
  assets    Asset[]
  createdAt DateTime   @default(now())
}

model User {
  id                   String                 @id @default(cuid())
  name                 String
  email                String                 @unique
  passwordHash         String
  roleId               String
  role                 Role                   @relation(fields: [roleId], references: [id])
  departmentId         String?
  department           Department?            @relation(fields: [departmentId], references: [id])
  phone                String?
  isActive             Boolean                @default(true)
  proposalsInitiated   Proposal[]             @relation("ProposalInitiator")
  approvalActions      ApprovalAction[]       @relation("ApproverActions")
  delegationsFrom      Delegation[]           @relation("Delegator")
  delegationsTo        Delegation[]           @relation("Delegatee")
  tasksAssigned        Task[]                 @relation("TaskAssignee")
  maintenanceAssigned  MaintenanceSchedule[]  @relation("MaintenanceAssignee")
  auditsConducted      AuditReview[]          @relation("AuditConductor")
  notifications        Notification[]
  auditLogs            AuditLog[]
  documentsUploaded    Document[]
  verifiedChanges      Change4M[]             @relation("ChangeVerifier")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Budget {
  id              String     @id @default(cuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  fiscalYear      String     // e.g. "FY2026-27"
  allocatedAmount Float
  utilisedAmount  Float      @default(0)
  currency        String     @default("INR")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([departmentId, fiscalYear])
}

model ProposalType {
  id               String            @id @default(cuid())
  code             String            @unique // NEW_MACHINE, REPLACEMENT, UPGRADATION, CAPACITY_EXPANSION, AUTOMATION, TOOL_DIE, INFRASTRUCTURE, SOFTWARE, MAINTENANCE_INV, ENERGY_SAVING, SAFETY_IMP, QUALITY_IMP, MANPOWER, PROCESS_IMP
  name             String
  description      String?
  icon             String?
  category         String            @default("CAPEX")
  isActive         Boolean           @default(true)
  formSchema       FormSchema?
  workflowTemplate WorkflowTemplate?
  proposals        Proposal[]
  createdAt        DateTime          @default(now())
}

model FormSchema {
  id                     String        @id @default(cuid())
  proposalTypeId         String        @unique
  proposalType           ProposalType  @relation(fields: [proposalTypeId], references: [id], onDelete: Cascade)
  fieldsJson             String        // JSON schema for form fields
  requiredFinancialsJson String        // JSON array of required financial keys
  checklistTemplateId    String?
  version                Int           @default(1)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model WorkflowTemplate {
  id             String          @id @default(cuid())
  proposalTypeId String          @unique
  proposalType   ProposalType    @relation(fields: [proposalTypeId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean         @default(true)
  version        Int             @default(1)
  stages         WorkflowStage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model WorkflowStage {
  id                  String           @id @default(cuid())
  workflowTemplateId  String
  workflowTemplate    WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  stepOrder           Int
  name                String           // e.g. "HOD Approval", "Technical Review", "Finance Evaluation", "Procurement Review", "Management Approval"
  approverRole        String           // Role name: HOD, Engineer, Finance, Procurement, Management, etc.
  slaDays             Int              @default(3)
  conditionExpr       String?          // e.g. "amount > 100000", "amount > 1000000"
  minAmount           Float?           // Threshold minimum
  maxAmount           Float?           // Threshold maximum
  checklistTemplateId String?
  proposals           Proposal[]       @relation("CurrentStage")
  approvalActions     ApprovalAction[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Proposal {
  id                     String            @id @default(cuid())
  proposalNumber         String            @unique // e.g. CF-2026-001
  title                  String
  proposalTypeId         String
  proposalType           ProposalType      @relation(fields: [proposalTypeId], references: [id])
  departmentId           String
  department             Department        @relation(fields: [departmentId], references: [id])
  initiatorId            String
  initiator              User              @relation("ProposalInitiator", fields: [initiatorId], references: [id])
  currentStageId         String?
  currentStage           WorkflowStage?    @relation("CurrentStage", fields: [currentStageId], references: [id])
  status                 String            @default("DRAFT") // DRAFT, IN_REVIEW, REVISION_REQUESTED, APPROVED, REJECTED, CANCELLED
  priority               String            @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  
  // Machine Details
  machineName            String?
  category               String?
  manufacturer           String?
  supplier               String?
  currentMachineDetails  String?           // For replacement/upgradation
  proposedMachineDetails String?
  expectedDeliveryWeeks  Int?              @default(4)
  
  // Cost breakdown
  purchasePrice          Float             @default(0)
  installationCost       Float             @default(0)
  transportCost          Float             @default(0)
  trainingCost           Float             @default(0)
  toolingCost            Float             @default(0)
  otherCost              Float             @default(0)
  totalInvestment        Float             @default(0)
  currency               String            @default("INR")
  
  // Financial Analysis Inputs & Calculated Outputs
  usefulLifeYears        Int               @default(5)
  discountRate           Float             @default(10) // Percentage, e.g. 10%
  salvageValue           Float             @default(0)
  annualSavings          Float             @default(0)
  extraRevenue           Float             @default(0)
  extraOpex              Float             @default(0)
  annualNetBenefit       Float             @default(0)
  simplePayback          Float             @default(0) // In years
  roiPercent             Float             @default(0) // Percentage
  npv                    Float             @default(0)
  irr                    Float             @default(0) // Percentage
  discountedPayback      Float             @default(0) // In years
  annualDepreciation     Float             @default(0)
  budgetImpactStatus     String            @default("WITHIN_BUDGET") // WITHIN_BUDGET, OVERRUN_WARNING, BUDGET_EXCEEDED
  
  // 5-Pillar Betterment Analysis (Stored as JSON string)
  bettermentJson         String?
  
  // Dynamic fields for other proposal types
  customFieldsJson       String?
  
  // Relations
  versions               ProposalVersion[]
  approvalActions        ApprovalAction[]
  quotations             Quotation[]
  purchaseOrders         PurchaseOrder[]
  changes4m              Change4M[]
  tasks                  Task[]
  assets                 Asset[]
  auditReviews           AuditReview[]
  documents              Document[]
  
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model ProposalVersion {
  id            String   @id @default(cuid())
  proposalId    String
  proposal      Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  versionNumber Int
  snapshotJson  String   // Complete snapshot of proposal at that version
  changedById   String
  changeSummary String?
  createdAt     DateTime @default(now())
}

model ApprovalAction {
  id                     String         @id @default(cuid())
  proposalId             String
  proposal               Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  stageId                String
  stage                  WorkflowStage  @relation(fields: [stageId], references: [id])
  stageName              String
  approverId             String
  approver               User           @relation("ApproverActions", fields: [approverId], references: [id])
  action                 String         // APPROVE, REJECT, REQUEST_REVISION, DELEGATE
  comments               String?
  checklistResponsesJson String?        // Verification items checked
  delegatedToId          String?
  createdAt              DateTime       @default(now())
}

model Delegation {
  id          String   @id @default(cuid())
  delegatorId String
  delegator   User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegateeId String
  delegatee   User     @relation("Delegatee", fields: [delegateeId], references: [id])
  role        String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ChecklistTemplate {
  id          String          @id @default(cuid())
  name        String
  category    String          // EVALUATION, IMPLEMENTATION, COMMISSIONING, VERIFICATION
  description String?
  items       ChecklistItem[]
  createdAt   DateTime        @default(now())
}

model ChecklistItem {
  id                  String            @id @default(cuid())
  checklistTemplateId String
  checklistTemplate   ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)
  itemText            String
  order               Int               @default(0)
  isMandatory         Boolean           @default(true)
  defaultAssigneeRole String?
  createdAt           DateTime          @default(now())
}

model Task {
  id                String    @id @default(cuid())
  proposalId        String?
  proposal          Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  change4mId        String?
  change4m          Change4M? @relation(fields: [change4mId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  assignedToId      String
  assignedTo        User      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  dueDate           DateTime
  completedAt       DateTime?
  status            String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE
  verificationNotes String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Change4M {
  id                 String    @id @default(cuid())
  proposalId         String?
  proposal           Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  changeCategory     String    // MAN, MACHINE, MATERIAL, METHOD
  title              String
  description        String
  reasonForChange    String
  riskAssessmentJson String    // severity, probability, riskScore, mitigationPlan
  impactProduction   String?
  impactQuality      String?
  impactSafety       String?
  status             String    @default("SUBMITTED") // DRAFT, SUBMITTED, APPROVED, IN_IMPLEMENTATION, VERIFIED, CLOSED
  closureNotes       String?
  closedAt           DateTime?
  verifiedById       String?
  verifiedBy         User?     @relation("ChangeVerifier", fields: [verifiedById], references: [id])
  tasks              Task[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Vendor {
  id                   String          @id @default(cuid())
  name                 String
  code                 String          @unique // e.g. VEND-001
  rating               Float           @default(4.0) // 1 to 5 scale
  contactPerson        String?
  email                String?
  phone                String?
  city                 String?
  categoriesJson       String?         // Categories of machinery supplied
  purchaseHistoryCount Int             @default(0)
  isApproved           Boolean         @default(true)
  quotations           Quotation[]
  purchaseOrders       PurchaseOrder[]
  assets               Asset[]
  createdAt            DateTime        @default(now())
}

model Quotation {
  id                  String          @id @default(cuid())
  proposalId          String
  proposal            Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  vendorId            String
  vendor              Vendor          @relation(fields: [vendorId], references: [id])
  quotationNumber     String
  quoteDate           DateTime        @default(now())
  validUntil          DateTime?
  price               Float
  installationCost    Float           @default(0)
  deliveryWeeks       Int             @default(4)
  warrantyMonths      Int             @default(12)
  capacityPerHour     Float?
  powerConsumptionKw  Float?
  technicalScore      Float           @default(80) // 0 - 100
  weightedScore       Float           @default(0)
  notes               String?
  isRecommended       Boolean         @default(false)
  isAccepted          Boolean         @default(false)
  purchaseOrders      PurchaseOrder[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model PurchaseOrder {
  id                  String    @id @default(cuid())
  poNumber            String    @unique // e.g. PO-2026-001
  proposalId          String
  proposal            Proposal  @relation(fields: [proposalId], references: [id])
  vendorId            String
  vendor              Vendor    @relation(fields: [vendorId], references: [id])
  quotationId         String?
  quotation           Quotation? @relation(fields: [quotationId], references: [id])
  totalAmount         Float
  currency            String    @default("INR")
  status              String    @default("CREATED") // CREATED, DISPATCHED, DELIVERED, INVOICED, PAID
  issuedDate          DateTime  @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate  DateTime?
  paymentTerms        String?
  createdById         String
  delivery            Delivery?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Delivery {
  id                      String        @id @default(cuid())
  purchaseOrderId         String        @unique
  purchaseOrder           PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  trackingNumber          String?
  carrier                 String?
  dispatchDate            DateTime?
  deliveryDate            DateTime?
  installationDate        DateTime?
  commissioningDate       DateTime?
  trainingCompletedDate   DateTime?
  qualityVerifiedById     String?
  engineeringVerifiedById String?
  status                  String        @default("DELIVERED") // IN_TRANSIT, DELIVERED, INSTALLED, COMMISSIONED, VERIFIED
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Asset {
  id                   String                @id @default(cuid())
  assetCode            String                @unique // e.g. AST-PROD-001
  name                 String
  proposalId           String?
  proposal             Proposal?             @relation(fields: [proposalId], references: [id])
  departmentId         String
  department           Department            @relation(fields: [departmentId], references: [id])
  vendorId             String?
  vendor               Vendor?               @relation(fields: [vendorId], references: [id])
  serialNumber         String?
  category             String?
  purchaseDate         DateTime              @default(now())
  commissioningDate    DateTime?
  purchaseCost         Float                 @default(0)
  warrantyExpiryDate   DateTime?
  location             String?
  status               String                @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED
  maintenanceSchedules MaintenanceSchedule[]
  auditReviews         AuditReview[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model MaintenanceSchedule {
  id              String    @id @default(cuid())
  assetId         String
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title           String
  frequencyType   String    @default("CALENDAR") // CALENDAR, OPERATING_HOURS
  frequencyValue  Int       @default(30) // e.g. every 30 days or 500 hours
  lastServiceDate DateTime?
  nextDueDate     DateTime?
  nextDueHours    Int?
  assignedToId    String?
  assignedTo      User?     @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])
  status          String    @default("SCHEDULED") // SCHEDULED, DUE, OVERDUE, COMPLETED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditReview {
  id                    String    @id @default(cuid())
  proposalId            String
  proposal              Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  assetId               String?
  asset                 Asset?    @relation(fields: [assetId], references: [id])
  intervalMonths        Int       // 3, 6, 12
  scheduledDate         DateTime
  conductedDate         DateTime?
  status                String    @default("PENDING") // PENDING, COMPLETED, OVERDUE
  actualProductionUnits Float?
  targetProductionUnits Float?
  actualSavings         Float?
  targetSavings         Float?
  actualRoi             Float?
  targetRoi             Float?
  deviationNotes        String?
  conductedById         String?
  conductedBy           User?     @relation("AuditConductor", fields: [conductedById], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Document {
  id           String    @id @default(cuid())
  proposalId   String?
  proposal     Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  entityType   String    // PROPOSAL, QUOTATION, PO, INVOICE, VERIFICATION, CHANGE4M
  entityId     String?
  fileName     String
  fileType     String
  fileSize     Int
  filePath     String
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // APPROVAL, ESCALATION, SLA_WARNING, WARRANTY, MAINTENANCE, AUDIT, SYSTEM
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

model SimulatedEmail {
  id            String   @id @default(cuid())
  toEmail       String
  recipientName String?
  subject       String
  bodyHtml      String
  category      String   // APPROVAL_REQUEST, SLA_ESCALATION, REVISION_REQUEST, PO_ISSUED, WARRANTY_ALERT, MAINTENANCE_ALERT
  sentAt        DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userName   String?
  entityType String   // PROPOSAL, WORKFLOW, CHANGE4M, PO, ASSET, QUOTATION
  entityId   String
  action     String   // CREATE, UPDATE, APPROVE, REJECT, REQUEST_REVISION, DELEGATE, DELETE
  beforeJson String?
  afterJson  String?
  ipAddress  String?
  timestamp  DateTime @default(now())
}
