# ChangeFlow Enterprise Environment Variables Configuration

# Server & Network
PORT=5000
NODE_ENV=development

# JWT Authentication (generate a cryptographically random 32+ character string for production)
JWT_SECRET=changeflow-enterprise-super-secure-jwt-secret-key-2026

# Database (SQLite default for zero-setup local/hackathon; portable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Background Automation & SLA Escalations Schedule (standard cron syntax)
# Default: runs hourly ('0 * * * *')
SLA_CRON_SCHEDULE="0 * * * *"

# Optional Live SMTP Email Settings (Nodemailer)
# If omitted or unconfigured, system falls back to simulated database audit logs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="ChangeFlow Enterprise <alerts@yourcompany.com>"
